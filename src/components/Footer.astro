---
---
<footer class="bg-dark text-cream pt-24 pb-8">
  <div class="max-w-[90rem] mx-auto px-6 md:px-12">
    <!-- Top section -->
    <div class="text-center md:text-left">
      <h2 class="font-display text-[clamp(3rem,8vw,7rem)] font-semibold tracking-tight leading-none text-cream">
        MINI SOCIETY
      </h2>
      <p class="font-display text-[clamp(1rem,2.5vw,1.5rem)] tracking-[0.35em] uppercase text-cream/40 mt-4">
        FOR LITTLE EXPLORERS
      </p>
    </div>

    <!-- Middle section -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Column 1 -->
      <div>
        <h3 class="font-display text-sm font-semibold text-cream/70 uppercase tracking-[0.2em] mb-4">
          Stay in the loop
        </h3>
        <form class="flex" onsubmit="event.preventDefault();">
          <input 
            type="email" 
            placeholder="Your email address" 
            class="bg-transparent border border-cream/15 text-cream placeholder:text-cream/30 px-4 py-3 rounded-l-full text-sm flex-1 focus:outline-none focus:border-cream/40"
            required
          />
          <button 
            type="submit"
            class="bg-mint text-dark px-6 py-3 rounded-r-full font-display text-sm font-medium tracking-wide hover:bg-mint/80 transition-colors flex items-center justify-center"
          >
            <span>&rarr;</span>
          </button>
        </form>
      </div>

      <!-- Column 2 -->
      <div>
        <h3 class="font-display text-xs tracking-[0.3em] text-cream/40 mb-4">
          NAVIGATE
        </h3>
        <ul class="space-y-2">
          <li>
            <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors block">Collection</a>
          </li>
          <li>
            <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors block">Our Story</a>
          </li>
          <li>
            <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors block">Craftsmanship</a>
          </li>
        </ul>
      </div>

      <!-- Column 3 -->
      <div>
        <h3 class="font-display text-xs tracking-[0.3em] text-cream/40 mb-4">
          CONNECT
        </h3>
        <ul class="space-y-2">
          <li>
            <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors block">Instagram</a>
          </li>
          <li>
            <a href="#" class="text-sm text-cream/60 hover:text-cream transition-colors block">Pinterest</a>
          </li>
          <li>
            <a href="mailto:hello@minisociety.com" class="text-sm text-cream/60 hover:text-cream transition-colors block">hello@minisociety.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-6 border-t border-cream/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-cream/30">
        &copy; 2026 Mini Society
      </p>
      <p class="text-xs text-cream/30">
        Made with care in India
      </p>
    </div>
  </div>
</footer>
