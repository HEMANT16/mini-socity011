---
// Header.astro
---
<header class="fixed top-0 left-0 right-0 z-50 w-full h-24 bg-transparent transition-all duration-300">
  <div class="container mx-auto px-6 md:px-12 lg:px-20 h-full flex items-center justify-between">
    
    <!-- Left Area: Logo -->
    <div class="flex items-center">
      <a href="/" class="font-display font-bold text-[13px] tracking-[0.2em] uppercase text-dark flex items-center">
        MINI SOCIETY
      </a>
    </div>

    <!-- Center Area: Nav -->
    <nav class="hidden md:flex items-center gap-10">
      <a href="#collection" class="font-display uppercase text-[10px] tracking-[0.25em] font-medium text-dark/40 hover:text-dark transition-colors">
        COLLECTION
      </a>
      <a href="#craftsmanship" class="font-display uppercase text-[10px] tracking-[0.25em] font-medium text-dark/40 hover:text-dark transition-colors">
        CRAFT
      </a>
      <a href="#story" class="font-display uppercase text-[10px] tracking-[0.25em] font-medium text-dark/40 hover:text-dark transition-colors">
        STORIES
      </a>
      <a href="#colors" class="font-display uppercase text-[10px] tracking-[0.25em] font-medium text-dark/40 hover:text-dark transition-colors">
        COLOURS
      </a>
    </nav>

    <!-- Right Area: Button -->
    <div class="flex items-center gap-4">
      <a href="#collection" class="hidden md:flex bg-dark text-cream text-[10px] tracking-[0.2em] uppercase font-semibold px-6 py-2.5 rounded-full hover:bg-dark/80 transition-colors whitespace-nowrap">
        EXPLORE
      </a>
      
      <!-- Mobile Hamburger -->
      <button class="md:hidden text-dark/70 hover:text-dark p-2" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>
</header>
