---
// Marquee.astro
---

<div class="w-full bg-dark text-sand py-4 overflow-hidden">
  <div class="marquee-track whitespace-nowrap flex items-center gap-12">
    {
      [1, 2, 3].map((_) => (
        <Fragment>
          <span class="font-display text-[11px] tracking-[0.35em] uppercase font-medium text-sand/70">
            Premium Comfort
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-mint inline-block" />
          <span class="font-display text-[11px] tracking-[0.35em] uppercase font-medium text-sand/70">
            Generation Alpha
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-mint inline-block" />
          <span class="font-display text-[11px] tracking-[0.35em] uppercase font-medium text-sand/70">
            Organic Materials
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-mint inline-block" />
          <span class="font-display text-[11px] tracking-[0.35em] uppercase font-medium text-sand/70">
            Crafted With Care
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-mint inline-block" />
          <span class="font-display text-[11px] tracking-[0.35em] uppercase font-medium text-sand/70">
            For Little Explorers
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-mint inline-block" />
        </Fragment>
      ))
    }
  </div>
</div>
