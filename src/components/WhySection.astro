---
---
<section class="bg-cream py-24 md:py-32">
  <div class="max-w-[90rem] mx-auto px-6 md:px-12">
    <div class="text-center">
      <h2 class="text-[11px] tracking-[0.35em] uppercase text-deep-green font-display font-medium mb-4">
        WHY MINI SOCIETY
      </h2>
      <p class="font-display text-4xl md:text-6xl lg:text-7xl font-light text-dark tracking-tight">
        Built different.
      </p>
      <p class="text-warm-grey text-base md:text-lg mt-4">
        Three promises we never break.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 mt-20">
      <!-- Column 1 -->
      <div class="text-center p-8">
        <div class="w-16 h-16 mx-auto bg-mint rounded-full flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-deep-green">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-semibold text-dark mt-6">Comfort First</h3>
        <p class="text-warm-grey text-sm leading-relaxed mt-3 max-w-[280px] mx-auto">
          Cloud-step cushioning that lets them run, jump, and explore all day without a single complaint.
        </p>
      </div>

      <!-- Column 2 -->
      <div class="text-center p-8">
        <div class="w-16 h-16 mx-auto bg-mint rounded-full flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-deep-green">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-semibold text-dark mt-6">Built to Move</h3>
        <p class="text-warm-grey text-sm leading-relaxed mt-3 max-w-[280px] mx-auto">
          Flexible soles and breathable construction designed for the way kids actually move.
        </p>
      </div>

      <!-- Column 3 -->
      <div class="text-center p-8">
        <div class="w-16 h-16 mx-auto bg-mint rounded-full flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-deep-green">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-semibold text-dark mt-6">Premium Materials</h3>
        <p class="text-warm-grey text-sm leading-relaxed mt-3 max-w-[280px] mx-auto">
          Vegan leather, organic cotton, and sustainable rubber — chosen with care for their world.
        </p>
      </div>
    </div>
  </div>
</section>
