---
---
<section class="py-24 bg-premium-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-black font-heading tracking-tighter uppercase mb-4 text-charcoal">The Essentials</h2>
      <p class="text-charcoal/70 max-w-2xl text-lg font-medium">Handcrafted for durability. Designed for the streets. See what everyone is talking about.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* Featured Card 1 */}
      <a href="/shop/essential-chunky" class="group relative overflow-hidden rounded-3xl aspect-square md:aspect-[4/5] bg-matte-black/5 flex flex-col justify-end p-8 border-4 border-transparent hover:border-sage-green transition-all duration-500">
        <img src="/shoe.png" alt="Mini Socity Essential Shoe" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
        <div class="relative z-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
          <span class="inline-block px-3 py-1 bg-premium-cream text-charcoal text-xs font-bold uppercase tracking-widest rounded-full mb-3">Best Seller</span>
          <h3 class="text-3xl font-black font-heading text-premium-cream uppercase">The Origin</h3>
          <p class="text-premium-cream/80 font-medium">Earth Tones / $85</p>
        </div>
      </a>

      {/* Featured Card 2 */}
      <a href="/shop/street-ready" class="group relative overflow-hidden rounded-3xl aspect-square md:aspect-[4/5] bg-matte-black/5 flex flex-col justify-end p-8 border-4 border-transparent hover:border-sage-green transition-all duration-500 mt-0 md:mt-16">
        <img src="/hero.png" alt="Kid wearing Mini Socity" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
        <div class="relative z-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
          <span class="inline-block px-3 py-1 bg-sage-green text-white text-xs font-bold uppercase tracking-widest rounded-full mb-3">Lookbook</span>
          <h3 class="text-3xl font-black font-heading text-premium-cream uppercase">Collection 01</h3>
          <p class="text-premium-cream/80 font-medium">Explore the gallery</p>
        </div>
      </a>
    </div>
  </div>
</section>
