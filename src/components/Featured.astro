---
---
<section class="bg-sand py-24 md:py-32">
  <div class="max-w-[90rem] mx-auto px-6 md:px-12">
    <div>
      <h2 class="text-[11px] tracking-[0.35em] uppercase text-deep-green font-display font-medium mb-4">
        LIFESTYLE
      </h2>
      <p class="font-display text-4xl md:text-6xl lg:text-7xl font-light text-dark tracking-tight">
        In their element.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mt-16">
      <!-- Card 1 -->
      <div class="md:col-span-7 aspect-[4/3] rounded-[24px] overflow-hidden relative group">
        <img src="/hero.png" alt="Lifestyle hero" class="object-cover w-full h-full group-hover:scale-102 transition-transform duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-dark/40 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6">
          <p class="font-display text-2xl font-semibold text-cream">Every day is an adventure</p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="md:col-span-5 aspect-[3/4] rounded-[24px] overflow-hidden relative bg-mint/30 flex flex-col items-center justify-center p-8 group">
        <img src="/shoe-mint.jpg" alt="Mint shoe" class="object-contain max-h-full group-hover:scale-102 transition-transform duration-500" />
        <div class="absolute bottom-6 left-0 w-full text-center">
          <p class="font-display text-lg font-semibold text-dark">The Mint Explorer</p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="md:col-span-5 aspect-[4/3] rounded-[24px] overflow-hidden relative bg-sand flex flex-col items-center justify-center p-8 group">
        <img src="/shoe-matcha.jpg" alt="Matcha shoe" class="object-contain max-h-full group-hover:scale-102 transition-transform duration-500" />
        <div class="absolute bottom-6 left-0 w-full text-center">
          <p class="font-display text-lg font-semibold text-dark">Matcha Berry</p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="md:col-span-7 aspect-[16/9] rounded-[24px] overflow-hidden relative bg-dark group">
        <div class="flex flex-col items-center justify-center h-full p-8 group-hover:scale-102 transition-transform duration-500">
          <p class="font-display text-3xl md:text-5xl font-light text-cream text-center">
            Parents buy. Kids love.
          </p>
          <p class="text-cream/60 text-sm mt-4 text-center">
            Designed like couture. Built for the playground.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
