---
import '../styles/global.css';

const { title = "MINI SOCIETY — For Little Explorers" } = Astro.props;
const description = "MINI SOCIETY — premium sneakers crafted for Generation Alpha. For little explorers. Parents buy, kids love.";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#F5F2EB" />
		<meta name="description" content={description} />
		<meta property="og:title" content="MINI SOCIETY — For Little Explorers" />
		<meta property="og:description" content="Premium sneakers crafted for Generation Alpha. Designed like couture, built for the playground." />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Fonts: General Sans + Satoshi from FontShare -->
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<!-- Film grain texture overlay -->
		<div class="grain" aria-hidden="true"></div>

		<slot />
	</body>
</html>
